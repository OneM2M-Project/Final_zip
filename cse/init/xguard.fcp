// flexContainer specialization for the X-Guard inspection result (spec, AI output rule 5)
// ACME loads every *.fcp in its base directory's init/ folder on startup.
[
    {
        "type"  : "xg:inRet",
        "lname" : "inspectionResult",
        "cnd"   : "org.alom.xguard.inspectionResult",
        "attributes" : [
            { "sname" : "seq",         "lname" : "seq",         "type" : "nonNegInteger", "car" : "01", "oc" : "O", "ou" : "O", "od" : "O", "annc" : "OA" },
            { "sname" : "productId",   "lname" : "productId",   "type" : "string",        "car" : "01", "oc" : "O", "ou" : "O", "od" : "O", "annc" : "OA" },
            { "sname" : "verdict",     "lname" : "verdict",     "type" : "string",        "car" : "01", "oc" : "O", "ou" : "O", "od" : "O", "annc" : "OA" },
            { "sname" : "defectClass", "lname" : "defectClass", "type" : "string",        "car" : "01", "oc" : "O", "ou" : "O", "od" : "O", "annc" : "OA" },
            { "sname" : "confidence",  "lname" : "confidence",  "type" : "float",         "car" : "01", "oc" : "O", "ou" : "O", "od" : "O", "annc" : "OA" },
            { "sname" : "inferenceMs", "lname" : "inferenceMs", "type" : "nonNegInteger", "car" : "01", "oc" : "O", "ou" : "O", "od" : "O", "annc" : "OA" },
            { "sname" : "modelVer",    "lname" : "modelVer",    "type" : "string",        "car" : "01", "oc" : "O", "ou" : "O", "od" : "O", "annc" : "OA" }
        ]
    }
]
