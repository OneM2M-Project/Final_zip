# ===== X-Guard settings, read by every Python program =====
# IP of the demo PC, as seen by the VM/pod on the same network. 127.0.0.1 if everything runs on one PC.
PC_IP=127.0.0.1
# IP of the MEC Sandbox VM (used once the AI runs there)
VM_IP=192.168.0.50

# ---- MN-CSE (ACME) ----
CSE_URL=http://127.0.0.1:8080
CSE_RN=cse-mn
CSE_ID=id-mn
ADMIN_ORIGIN=CAdmin

# ---- MQTT (Mosquitto) ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# ---- Arduino serial ----
# e.g. COM3 on Windows, or SIM to run without hardware
SERIAL_PORT=SIM
SERIAL_BAUD=115200
# SIM mode: seconds between arrivals at S1, and S1 -> S2 travel time in seconds
SIM_ARRIVE_SEC=4
SIM_TRAVEL_SEC=3

# ---- image AE ----
IMAGE_PORT=9200
IMAGE_DIR=dataset
# dataset: images from dataset/ in order | camera: USB camera (ELP OV9281, 850 nm)
IMAGE_SOURCE=dataset
# Our ELP is index 1 with MSMF on Windows (the laptop webcam is 0). DSHOW gives a black frame.
CAMERA_INDEX=1
CAMERA_BACKEND=MSMF
CAMERA_FOURCC=MJPG
CAMERA_WIDTH=1280
CAMERA_HEIGHT=800
# 180 because the camera is mounted upside down. Training photos were rotated the same way and must match.
CAMERA_ROTATE=180
# h or v to mirror horizontally or vertically
CAMERA_FLIP=
# Empty = auto exposure. If brightness jumps around, fix it, e.g. -6 (MSMF may ignore this).
CAMERA_EXPOSURE=
# Travel time in ms from S1 to the middle of the camera frame.
# 0 if S1 sits right in front of the camera; otherwise distance / belt speed.
CAPTURE_DELAY_MS=0
# 1 = save every frame to captures/ (label them and drop them in train/dataset for training)
SAVE_CAPTURES=0

# ---- AI AE ----
# AI in docker on the PC: http://<PC_IP>:9000/notify
# AI on MEC:                http://<VM_IP>:30900/notify
AI_NOTIFY_URL=http://127.0.0.1:9000/notify
AI_PORT=9000
MODEL_PATH=models/detect.pt
CLASSES_PATH=models/classes.txt
# torchscript (default) | ultralytics | dummy (no model, for testing the flow)
MODEL_BACKEND=torchscript
IMG_SIZE=640
CONF_TH=0.5
MODEL_VER=yolov8n-xguard-1.0
# ---- auto training (run_all trains on startup if train/dataset has data) ----
# 0 turns auto training off
AUTO_TRAIN=1
TRAIN_MODEL=yolov8n
TRAIN_EPOCHS=100
# 8 or -1 (auto) if the GPU runs out of memory
TRAIN_BATCH=16
TRAIN_PATIENCE=20
# Empty = GPU if there is one, else CPU. Or 0 / cpu.
TRAIN_DEVICE=
TRAIN_WORKERS=4
TRAIN_AUG=nir
# flex: inspectionResult is an xg:inRet flexContainer | cin: plain container (if ACME can't load the specialization)
RESULT_MODE=flex

# ---- dashboard ----
DASH_NOTIFY_PORT=9100
