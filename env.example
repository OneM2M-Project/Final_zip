# ===== X-Guard 공통 설정 (모든 Python 프로그램이 이 파일을 읽어요) =====
# 시연용 PC의 IP (같은 네트워크의 VM/Pod가 접속할 주소). 혼자 PC에서만 시험할 땐 127.0.0.1
PC_IP=127.0.0.1
# MEC Sandbox VM의 IP (AI를 MEC로 옮긴 뒤에 사용)
VM_IP=192.168.0.50

# ---- MN-CSE (ACME) ----
CSE_URL=http://127.0.0.1:8080
CSE_RN=cse-mn
CSE_ID=id-mn
ADMIN_ORIGIN=CAdmin

# ---- MQTT (Mosquitto) ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# ---- 아두이노 시리얼 ----
# Windows 예: COM3 / 하드웨어 없이 시험하려면 SIM
SERIAL_PORT=SIM
SERIAL_BAUD=115200
# SIM 모드에서 IR1(도착) 간격(초)과 IR1→IR2 이동 시간(초)
SIM_ARRIVE_SEC=4
SIM_TRAVEL_SEC=3

# ---- 이미지 AE ----
IMAGE_PORT=9200
IMAGE_DIR=dataset
# dataset: dataset/ 이미지를 순서대로 | camera: USB 카메라(ELP OV9281 850nm)에서 촬영
IMAGE_SOURCE=dataset
# 우리 ELP 카메라: Windows 에서 MSMF 방식 1번 (노트북 내장 카메라가 0번). DSHOW 로 열면 새까맣게 나옴
CAMERA_INDEX=1
CAMERA_BACKEND=MSMF
CAMERA_FOURCC=MJPG
CAMERA_WIDTH=1280
CAMERA_HEIGHT=800
# 카메라를 거꾸로 달아서 180 (학습 사진도 180도 돌려 찍었음 -> 같은 방향이어야 AI 가 맞힘)
CAMERA_ROTATE=180
# 좌우/상하 반전이 필요하면 h 또는 v
CAMERA_FLIP=
# 비우면 자동 노출. 밝기가 들쭉날쭉하면 -6 처럼 고정 (MSMF 에서는 안 먹힐 수 있음)
CAMERA_EXPOSURE=
# 감지 센서(S1) -> 카메라 화면 가운데까지 가는 시간(ms).
# 카메라는 벨트 옆에서 옆으로 찍으므로, S1 을 카메라 정면에 두면 0. 카메라보다 앞에 두면 (거리 / 벨트 속도)
CAPTURE_DELAY_MS=0
# 1 이면 찍은 사진을 captures/ 에 저장 (라벨링해서 train/dataset 에 넣으면 학습 데이터)
SAVE_CAPTURES=0

# ---- AI AE ----
# PC에서 docker run으로 시험할 때: http://<PC_IP>:9000/notify
# MEC로 옮긴 뒤:                   http://<VM_IP>:30900/notify
AI_NOTIFY_URL=http://127.0.0.1:9000/notify
AI_PORT=9000
MODEL_PATH=models/detect.pt
CLASSES_PATH=models/classes.txt
# torchscript(기본) | ultralytics | dummy(모델 없이 흐름 시험)
MODEL_BACKEND=torchscript
IMG_SIZE=640
CONF_TH=0.5
MODEL_VER=yolov8n-xguard-1.0
# ---- 모델 자동 학습 (train/dataset 에 데이터가 있으면 run_all 시작 때 학습) ----
# 0 이면 자동 학습 안 함
AUTO_TRAIN=1
TRAIN_MODEL=yolov8n
TRAIN_EPOCHS=100
# GPU 메모리가 부족하면 8 또는 -1(자동)
TRAIN_BATCH=16
TRAIN_PATIENCE=20
# 비우면 GPU 있으면 GPU, 없으면 CPU. 0 / cpu
TRAIN_DEVICE=
TRAIN_WORKERS=4
TRAIN_AUG=nir
# flex: inspectionResult를 flexContainer(xg:inRet)로 / cin: 일반 컨테이너로 (ACME에 특수화 등록이 안 될 때)
RESULT_MODE=flex

# ---- 대시보드 ----
DASH_NOTIFY_PORT=9100
